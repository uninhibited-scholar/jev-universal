# Private local file: copy outside the repository and fill in your own key.
TYPESAFE_API_KEY=
# Alternatively: TYPESAFE_API_KEY_FILE=/absolute/path/to/private-key-file
JEV_MODEL=jev-latest
# HTTP defaults to loopback. For public deployment set ALL OAuth fields:
# JEV_HOST=0.0.0.0
# JEV_PORT=8765
# JEV_PUBLIC_URL=https://jev.your-domain.example/mcp
# JEV_OAUTH_ISSUER=https://your-issuer.example/
# JEV_OAUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
