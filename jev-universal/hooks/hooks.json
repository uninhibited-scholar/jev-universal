{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking for large command output"
          }
        ]
      }
    ]
  }
}
